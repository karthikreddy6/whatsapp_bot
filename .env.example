# Server Port
PORT=3000

# WhatsApp Feature Toggle (true / false)
ENABLE_WHATSAPP=true

# Canteen WhatsApp number for operational alerts (e.g. 919876543210)
CANTEEN_WHATSAPP=

# Running inside Docker requires headless=true
WHATSAPP_HEADLESS=true

# Shared secret key between FastAPI backend and WhatsApp bot for OTP delivery
INTERNAL_API_KEY=

# Message rate limiting & typing behavior
WHATSAPP_MESSAGE_DELAY_MS=5000
HUMAN_TYPING_ENABLED=true
RECENT_WINDOW_MS=7200000

# Path to Chromium binary inside Docker container
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# PostgreSQL Database Configuration
PG_HOST=localhost
PG_PORT=5432
PG_USER=buvvadb
PG_PASSWORD=buvvA@6
PG_DATABASE=onfood
